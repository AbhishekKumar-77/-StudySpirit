# ===========================
# StudySpirit Environment Config
# ===========================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/studyspirit?retryWrites=true&w=majority

# Session
SESSION_SECRET=your_super_secret_session_key_change_this_in_production

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Groq AI API
GROQ_API_KEY=your_groq_api_key

# Frontend URL (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# ===========================
# PRODUCTION DEPLOYMENT NOTES
# ===========================
# 1. Set NODE_ENV=production
# 2. Set FRONTEND_URL to your actual frontend domain
# 3. Update all callback URLs to production domain
# 4. Use a strong, random SESSION_SECRET (min 64 chars)
# 5. Ensure MONGODB_URI points to your production cluster
